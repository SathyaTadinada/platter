{
  "name": "platter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // assets too, so a missing file 404s instead of getting index.html (see worker)
    "run_worker_first": ["/api/*", "/assets/*"],
  },
  "routes": [{ "pattern": "platter.tadinada.com", "custom_domain": true }],
  // per-IP limits; one sign call covers up to 60 Discogs requests
  "ratelimits": [
    { "name": "SIGN_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "SYNC_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    // wrong sync passwords, per account name, wherever they come from
    { "name": "LOGIN_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // Discogs login checks through Browser Run, which has 10 minutes a day on the free plan
    { "name": "CONFIRM_LIMITER", "namespace_id": "1005", "simple": { "limit": 3, "period": 60 } },
  ],
  // a headless browser that can reach Discogs when the Worker can't (worker/confirm.ts)
  "browser": { "binding": "BROWSER" },
  // cloud sync
  "d1_databases": [
    { "binding": "DB", "database_name": "platter", "database_id": "925a7706-80d0-4657-86d7-91fc13c4afc5", "migrations_dir": "migrations" },
  ],
}
